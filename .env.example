####################################################################
# GSRP — Environment Configuration Template
# Copy this file to .env and fill in your own values.
# See README.md for step-by-step setup instructions.
####################################################################

# ── Flask Core ─────────────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-change-this-in-production
FLASK_ENV=development
FLASK_DEBUG=1

# ── Database (main app) ────────────────────────────────────────────
DATABASE_URL=sqlite:///whitelist.db
# For production use PostgreSQL instead:
# DATABASE_URL=postgresql://user:password@localhost:5432/whitelist_db

# ── Redis (caching & sessions) ─────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Discord OAuth2 (site login) ────────────────────────────────────
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=http://localhost:5010/auth/discord/callback
DISCORD_GUILD_ID=your_discord_server_id

# Role ID that unlocks staff/admin tools inside the portal
STAFF_ROLE_ID=your_staff_role_id

# Role ID a player must have in Discord to pass the FiveM whitelist check
REQUIRED_DISCORD_ROLE_ID=your_required_discord_role_id

# Category a new support ticket channel gets created under
DISCORD_TICKET_CATEGORY_ID=your_ticket_category_id

# ── Discord Bot (discord_bot.py — leaderboard + notifications) ────
DISCORD_BOT_TOKEN=your_discord_bot_token
LEADERBOARD_CHANNEL_ID=your_leaderboard_channel_id
INTERVIEW_CHANNEL_ID=your_interview_channel_id
JOIN_LOG_CHANNEL_ID=your_join_log_channel_id

# ── Discord Webhooks ────────────────────────────────────────────────
# Posts new interview bookings for staff to see
INTERVIEW_DISCORD_WEBHOOK=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
# Posts flagged/suspicious in-game economy activity
ECONOMY_FLAGS_WEBHOOK=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
# Logs every whitelist join/deny attempt
WHITELIST_LOG_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
# Shared secret for verifying inbound webhook requests (leave blank to disable)
WEBHOOK_SECRET=
BOT_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# ── FiveM / External API ───────────────────────────────────────────
FIVEM_API_KEY=your-fivem-api-key
API_KEY_SECRET=your-api-secret-for-external-integrations

# ── AI Analytics (Anthropic API — powers the analytics/self-heal tools) ─
ANTHROPIC_API_KEY=

# ── Mail (optional — password resets & notifications) ─────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your@email.com
MAIL_PASSWORD=your-app-password

# ── Site Settings ───────────────────────────────────────────────────
SITE_NAME=CFRP Whitelist
SITE_URL=http://localhost:5010
MAX_CONTENT_LENGTH=16777216

# ── 2FA ─────────────────────────────────────────────────────────────
TOTP_ISSUER=CFRP Whitelist

# ── Bot MySQL DB (separate database, used for ticket-channel lookups) ─
BOT_DB_HOST=localhost
BOT_DB_PORT=3306
BOT_DB_NAME=cfrp_bot
BOT_DB_USER=your_mysql_user
BOT_DB_PASSWORD=your_mysql_password
# Generic fallbacks BOT_DB_USER / BOT_DB_PASSWORD use if the BOT_DB_* ones
# above aren't set — leave blank unless you specifically need them
DB_USER=
DB_PASSWORD=
