####################################################################
# GSRP — Environment Configuration
# Every setting the web app, discord_bot.py, and their background
# jobs read at startup lives in this one file.
####################################################################

# ── Flask Core ─────────────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-change-this-in-production
FLASK_ENV=development
FLASK_DEBUG=1

# ── Database (main app) ────────────────────────────────────────────
